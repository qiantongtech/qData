<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tech.qiantong.qdata.module.dm.dal.mapper.businessCategory.DmBusinessDomainRelMapper">

    <resultMap type="DmBusinessDomainRelDO" id="DmBusinessDomainRelResult">
        <result property="id"    column="ID"    />
        <result property="businessCategoryId"    column="BUSINESS_CATEGORY_ID"    />
        <result property="dataDomainId"    column="DATA_DOMAIN_ID"    />
        <result property="businessCategoryName"    column="BUSINESS_CATEGORY_NAME"    />
        <result property="dataDomainName"    column="DATA_DOMAIN_NAME"    />
        <result property="sortOrder"    column="SORT_ORDER"    />
        <result property="description"    column="DESCRIPTION"    />
        <result property="validFlag"    column="VALID_FLAG"    />
        <result property="delFlag"    column="DEL_FLAG"    />
        <result property="createBy"    column="CREATE_BY"    />
        <result property="creatorId"    column="CREATOR_ID"    />
        <result property="createTime"    column="CREATE_TIME"    />
        <result property="updateBy"    column="UPDATE_BY"    />
        <result property="updaterId"    column="UPDATER_ID"    />
        <result property="updateTime"    column="UPDATE_TIME"    />
        <result property="remark"    column="REMARK"    />
    </resultMap>

    <sql id="selectDmBusinessDomainRelVo">
        select ID, BUSINESS_CATEGORY_ID, DATA_DOMAIN_ID, BUSINESS_CATEGORY_NAME, DATA_DOMAIN_NAME, SORT_ORDER, DESCRIPTION, VALID_FLAG, DEL_FLAG, CREATE_BY, CREATOR_ID, CREATE_TIME, UPDATE_BY, UPDATER_ID, UPDATE_TIME, REMARK from DM_BUSINESS_DOMAIN_REL
    </sql>

    <select id="selectDmBusinessDomainRelList" parameterType="DmBusinessDomainRelDO" resultMap="DmBusinessDomainRelResult">
        <include refid="selectDmBusinessDomainRelVo"/>
        <where>
            <if test="businessCategoryId != null "> and BUSINESS_CATEGORY_ID = #{businessCategoryId}</if>
            <if test="dataDomainId != null "> and DATA_DOMAIN_ID = #{dataDomainId}</if>
            <if test="businessCategoryName != null  and businessCategoryName != ''"> and BUSINESS_CATEGORY_NAME like concat(concat('%', #{businessCategoryName}), '%')</if>
            <if test="dataDomainName != null  and dataDomainName != ''"> and DATA_DOMAIN_NAME like concat(concat('%', #{dataDomainName}), '%')</if>
            <if test="sortOrder != null "> and SORT_ORDER = #{sortOrder}</if>
            <if test="description != null  and description != ''"> and DESCRIPTION = #{description}</if>
            <if test="validFlag != null "> and VALID_FLAG = #{validFlag}</if>
            <if test="createTime != null "> and CREATE_TIME = #{createTime}</if>
        </where>
    </select>

    <select id="selectDmBusinessDomainRelById" parameterType="Long" resultMap="DmBusinessDomainRelResult">
        <include refid="selectDmBusinessDomainRelVo"/>
        where ID = #{id}
    </select>

    <insert id="insertDmBusinessDomainRel" parameterType="DmBusinessDomainRelDO">
        insert into DM_BUSINESS_DOMAIN_REL
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">ID,</if>
            <if test="businessCategoryId != null">BUSINESS_CATEGORY_ID,</if>
            <if test="dataDomainId != null">DATA_DOMAIN_ID,</if>
            <if test="businessCategoryName != null">BUSINESS_CATEGORY_NAME,</if>
            <if test="dataDomainName != null">DATA_DOMAIN_NAME,</if>
            <if test="sortOrder != null">SORT_ORDER,</if>
            <if test="description != null">DESCRIPTION,</if>
            <if test="validFlag != null">VALID_FLAG,</if>
            <if test="delFlag != null">DEL_FLAG,</if>
            <if test="createBy != null">CREATE_BY,</if>
            <if test="creatorId != null">CREATOR_ID,</if>
            <if test="createTime != null">CREATE_TIME,</if>
            <if test="updateBy != null">UPDATE_BY,</if>
            <if test="updaterId != null">UPDATER_ID,</if>
            <if test="updateTime != null">UPDATE_TIME,</if>
            <if test="remark != null">REMARK,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="businessCategoryId != null">#{businessCategoryId},</if>
            <if test="dataDomainId != null">#{dataDomainId},</if>
            <if test="businessCategoryName != null">#{businessCategoryName},</if>
            <if test="dataDomainName != null">#{dataDomainName},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="description != null">#{description},</if>
            <if test="validFlag != null">#{validFlag},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="creatorId != null">#{creatorId},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updaterId != null">#{updaterId},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateDmBusinessDomainRel" parameterType="DmBusinessDomainRelDO">
        update DM_BUSINESS_DOMAIN_REL
        <trim prefix="SET" suffixOverrides=",">
            <if test="businessCategoryId != null">BUSINESS_CATEGORY_ID = #{businessCategoryId},</if>
            <if test="dataDomainId != null">DATA_DOMAIN_ID = #{dataDomainId},</if>
            <if test="businessCategoryName != null">BUSINESS_CATEGORY_NAME = #{businessCategoryName},</if>
            <if test="dataDomainName != null">DATA_DOMAIN_NAME = #{dataDomainName},</if>
            <if test="sortOrder != null">SORT_ORDER = #{sortOrder},</if>
            <if test="description != null">DESCRIPTION = #{description},</if>
            <if test="validFlag != null">VALID_FLAG = #{validFlag},</if>
            <if test="delFlag != null">DEL_FLAG = #{delFlag},</if>
            <if test="createBy != null">CREATE_BY = #{createBy},</if>
            <if test="creatorId != null">CREATOR_ID = #{creatorId},</if>
            <if test="createTime != null">CREATE_TIME = #{createTime},</if>
            <if test="updateBy != null">UPDATE_BY = #{updateBy},</if>
            <if test="updaterId != null">UPDATER_ID = #{updaterId},</if>
            <if test="updateTime != null">UPDATE_TIME = #{updateTime},</if>
            <if test="remark != null">REMARK = #{remark},</if>
        </trim>
        where ID = #{id}
    </update>

    <delete id="deleteDmBusinessDomainRelById" parameterType="Long">
        delete from DM_BUSINESS_DOMAIN_REL where ID = #{id}
    </delete>

    <delete id="deleteDmBusinessDomainRelByIds" parameterType="String">
        delete from DM_BUSINESS_DOMAIN_REL where ID in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
