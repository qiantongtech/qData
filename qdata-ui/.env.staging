# Page title
VITE_APP_TITLE = qData Open-Source Data Platform

# Production environment configuration
VITE_APP_ENV = 'staging'

# qData open source version/production environment
VITE_APP_BASE_API = '/stage-api'

# Whether to enable compression when packaging, supports gzip and brotli
VITE_BUILD_COMPRESS = gzip

# Authentication mode [default mode (client), single point mode (sso)]
VITE_APP_AUTH_TYPE = 'client'

# Application ID
VITE_APP_CLIENTID = 9d04db60ab904313a43ebb78c9f027c1

# Unified identity authentication URL address
VITE_APP_SERVER_URL = http://127.0.0.1:8899

# The URL address of the current APP
VITE_APP_THIS_APP_URL =http://127.0.0.1:80

# Whether to proxy PUT and DELETE requests
VITE_APP_OPEN_PROXY_PUT_DELETE_REQUEST = 'false'

# Resource preview address
VITE_RP_VIEW_URL='http://127.0.0.1:8012'

# AES key
VITE_APP_AES_KEY = 'AD42F6697B035B75'
