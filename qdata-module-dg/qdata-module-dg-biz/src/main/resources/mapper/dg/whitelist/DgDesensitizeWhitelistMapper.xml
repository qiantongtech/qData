<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tech.qiantong.qdata.module.dg.dal.mapper.whitelist.DgDesensitizeWhitelistMapper">

    <resultMap type="DgDesensitizeWhitelistDO" id="DgDesensitizeWhitelistResult">
        <result property="id"    column="ID"    />
        <result property="name"    column="NAME"    />
        <result property="dataCategoryId"    column="DATA_CATEGORY_ID"    />
        <result property="effectiveCategory"    column="EFFECTIVE_CATEGORY"    />
        <result property="startTime"    column="START_TIME"    />
        <result property="endTime"    column="END_TIME"    />
        <result property="sortOrder"    column="SORT_ORDER"    />
        <result property="description"    column="DESCRIPTION"    />
        <result property="validFlag"    column="VALID_FLAG"    />
        <result property="delFlag"    column="DEL_FLAG"    />
        <result property="createBy"    column="CREATE_BY"    />
        <result property="creatorId"    column="CREATOR_ID"    />
        <result property="createTime"    column="CREATE_TIME"    />
        <result property="updateBy"    column="UPDATE_BY"    />
        <result property="updaterId"    column="UPDATER_ID"    />
        <result property="updateTime"    column="UPDATE_TIME"    />
        <result property="remark"    column="REMARK"    />
    </resultMap>

    <sql id="selectDgDesensitizeWhitelistVo">
        select ID, NAME, DATA_CATEGORY_ID, EFFECTIVE_CATEGORY, START_TIME, END_TIME, SORT_ORDER, DESCRIPTION, VALID_FLAG, DEL_FLAG, CREATE_BY, CREATOR_ID, CREATE_TIME, UPDATE_BY, UPDATER_ID, UPDATE_TIME, REMARK from DG_DESENSITIZE_WHITELIST
    </sql>

    <select id="selectDgDesensitizeWhitelistList" parameterType="DgDesensitizeWhitelistDO" resultMap="DgDesensitizeWhitelistResult">
        <include refid="selectDgDesensitizeWhitelistVo"/>
        <where>
            <if test="name != null  and name != ''"> and NAME like concat('%', #{name}, '%')</if>
            <if test="dataCategoryId != null "> and DATA_CATEGORY_ID = #{dataCategoryId}</if>
            <if test="effectiveCategory != null  and effectiveCategory != ''"> and EFFECTIVE_CATEGORY = #{effectiveCategory}</if>
            <if test="startTime != null "> and START_TIME = #{startTime}</if>
            <if test="endTime != null "> and END_TIME = #{endTime}</if>
            <if test="sortOrder != null "> and SORT_ORDER = #{sortOrder}</if>
            <if test="description != null  and description != ''"> and DESCRIPTION = #{description}</if>
            <if test="validFlag != null "> and VALID_FLAG = #{validFlag}</if>
            <if test="createTime != null "> and CREATE_TIME = #{createTime}</if>
        </where>
    </select>

    <select id="selectDgDesensitizeWhitelistById" parameterType="Long" resultMap="DgDesensitizeWhitelistResult">
        <include refid="selectDgDesensitizeWhitelistVo"/>
        where ID = #{id}
    </select>

    <insert id="insertDgDesensitizeWhitelist" parameterType="DgDesensitizeWhitelistDO">
        insert into DG_DESENSITIZE_WHITELIST
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">ID,</if>
            <if test="name != null">NAME,</if>
            <if test="dataCategoryId != null">DATA_CATEGORY_ID,</if>
            <if test="effectiveCategory != null">EFFECTIVE_CATEGORY,</if>
            <if test="startTime != null">START_TIME,</if>
            <if test="endTime != null">END_TIME,</if>
            <if test="sortOrder != null">SORT_ORDER,</if>
            <if test="description != null">DESCRIPTION,</if>
            <if test="validFlag != null">VALID_FLAG,</if>
            <if test="delFlag != null">DEL_FLAG,</if>
            <if test="createBy != null">CREATE_BY,</if>
            <if test="creatorId != null">CREATOR_ID,</if>
            <if test="createTime != null">CREATE_TIME,</if>
            <if test="updateBy != null">UPDATE_BY,</if>
            <if test="updaterId != null">UPDATER_ID,</if>
            <if test="updateTime != null">UPDATE_TIME,</if>
            <if test="remark != null">REMARK,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="name != null">#{name},</if>
            <if test="dataCategoryId != null">#{dataCategoryId},</if>
            <if test="effectiveCategory != null">#{effectiveCategory},</if>
            <if test="startTime != null">#{startTime},</if>
            <if test="endTime != null">#{endTime},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="description != null">#{description},</if>
            <if test="validFlag != null">#{validFlag},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="creatorId != null">#{creatorId},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updaterId != null">#{updaterId},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateDgDesensitizeWhitelist" parameterType="DgDesensitizeWhitelistDO">
        update DG_DESENSITIZE_WHITELIST
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null">NAME = #{name},</if>
            <if test="dataCategoryId != null">DATA_CATEGORY_ID = #{dataCategoryId},</if>
            <if test="effectiveCategory != null">EFFECTIVE_CATEGORY = #{effectiveCategory},</if>
            <if test="startTime != null">START_TIME = #{startTime},</if>
            <if test="endTime != null">END_TIME = #{endTime},</if>
            <if test="sortOrder != null">SORT_ORDER = #{sortOrder},</if>
            <if test="description != null">DESCRIPTION = #{description},</if>
            <if test="validFlag != null">VALID_FLAG = #{validFlag},</if>
            <if test="delFlag != null">DEL_FLAG = #{delFlag},</if>
            <if test="createBy != null">CREATE_BY = #{createBy},</if>
            <if test="creatorId != null">CREATOR_ID = #{creatorId},</if>
            <if test="createTime != null">CREATE_TIME = #{createTime},</if>
            <if test="updateBy != null">UPDATE_BY = #{updateBy},</if>
            <if test="updaterId != null">UPDATER_ID = #{updaterId},</if>
            <if test="updateTime != null">UPDATE_TIME = #{updateTime},</if>
            <if test="remark != null">REMARK = #{remark},</if>
        </trim>
        where ID = #{id}
    </update>

    <delete id="deleteDgDesensitizeWhitelistById" parameterType="Long">
        delete from DG_DESENSITIZE_WHITELIST where ID = #{id}
    </delete>

    <delete id="deleteDgDesensitizeWhitelistByIds" parameterType="String">
        delete from DG_DESENSITIZE_WHITELIST where ID in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
