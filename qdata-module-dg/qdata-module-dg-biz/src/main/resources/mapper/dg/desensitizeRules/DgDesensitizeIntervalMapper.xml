<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tech.qiantong.qdata.module.dg.dal.mapper.desensitizeRules.DgDesensitizeIntervalMapper">

    <resultMap type="DgDesensitizeIntervalDO" id="DgDesensitizeIntervalResult">
        <result property="id"    column="ID"    />
        <result property="desensitizeRuleId"    column="DESENSITIZE_RULE_ID"    />
        <result property="intervalNo"    column="INTERVAL_NO"    />
        <result property="startNum"    column="START_NUM"    />
        <result property="endNum"    column="END_NUM"    />
        <result property="validFlag"    column="VALID_FLAG"    />
        <result property="delFlag"    column="DEL_FLAG"    />
        <result property="createBy"    column="CREATE_BY"    />
        <result property="creatorId"    column="CREATOR_ID"    />
        <result property="createTime"    column="CREATE_TIME"    />
        <result property="updateBy"    column="UPDATE_BY"    />
        <result property="updaterId"    column="UPDATER_ID"    />
        <result property="updateTime"    column="UPDATE_TIME"    />
        <result property="remark"    column="REMARK"    />
    </resultMap>

    <sql id="selectDgDesensitizeIntervalVo">
        select ID, DESENSITIZE_RULE_ID, INTERVAL_NO, START_NUM, END_NUM, VALID_FLAG, DEL_FLAG, CREATE_BY, CREATOR_ID, CREATE_TIME, UPDATE_BY, UPDATER_ID, UPDATE_TIME, REMARK from DG_DESENSITIZE_INTERVAL
    </sql>

    <select id="selectDgDesensitizeIntervalList" parameterType="DgDesensitizeIntervalDO" resultMap="DgDesensitizeIntervalResult">
        <include refid="selectDgDesensitizeIntervalVo"/>
        <where>
            <if test="desensitizeRuleId != null "> and DESENSITIZE_RULE_ID = #{desensitizeRuleId}</if>
            <if test="intervalNo != null "> and INTERVAL_NO = #{intervalNo}</if>
            <if test="startNum != null "> and START_NUM = #{startNum}</if>
            <if test="endNum != null "> and END_NUM = #{endNum}</if>
            <if test="validFlag != null "> and VALID_FLAG = #{validFlag}</if>
            <if test="createTime != null "> and CREATE_TIME = #{createTime}</if>
        </where>
    </select>

    <select id="selectDgDesensitizeIntervalById" parameterType="Long" resultMap="DgDesensitizeIntervalResult">
        <include refid="selectDgDesensitizeIntervalVo"/>
        where ID = #{id}
    </select>

    <insert id="insertDgDesensitizeInterval" parameterType="DgDesensitizeIntervalDO">
        insert into DG_DESENSITIZE_INTERVAL
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">ID,</if>
            <if test="desensitizeRuleId != null">DESENSITIZE_RULE_ID,</if>
            <if test="intervalNo != null">INTERVAL_NO,</if>
            <if test="startNum != null">START_NUM,</if>
            <if test="endNum != null">END_NUM,</if>
            <if test="validFlag != null">VALID_FLAG,</if>
            <if test="delFlag != null">DEL_FLAG,</if>
            <if test="createBy != null">CREATE_BY,</if>
            <if test="creatorId != null">CREATOR_ID,</if>
            <if test="createTime != null">CREATE_TIME,</if>
            <if test="updateBy != null">UPDATE_BY,</if>
            <if test="updaterId != null">UPDATER_ID,</if>
            <if test="updateTime != null">UPDATE_TIME,</if>
            <if test="remark != null">REMARK,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="desensitizeRuleId != null">#{desensitizeRuleId},</if>
            <if test="intervalNo != null">#{intervalNo},</if>
            <if test="startNum != null">#{startNum},</if>
            <if test="endNum != null">#{endNum},</if>
            <if test="validFlag != null">#{validFlag},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="creatorId != null">#{creatorId},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updaterId != null">#{updaterId},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateDgDesensitizeInterval" parameterType="DgDesensitizeIntervalDO">
        update DG_DESENSITIZE_INTERVAL
        <trim prefix="SET" suffixOverrides=",">
            <if test="desensitizeRuleId != null">DESENSITIZE_RULE_ID = #{desensitizeRuleId},</if>
            <if test="intervalNo != null">INTERVAL_NO = #{intervalNo},</if>
            <if test="startNum != null">START_NUM = #{startNum},</if>
            <if test="endNum != null">END_NUM = #{endNum},</if>
            <if test="validFlag != null">VALID_FLAG = #{validFlag},</if>
            <if test="delFlag != null">DEL_FLAG = #{delFlag},</if>
            <if test="createBy != null">CREATE_BY = #{createBy},</if>
            <if test="creatorId != null">CREATOR_ID = #{creatorId},</if>
            <if test="createTime != null">CREATE_TIME = #{createTime},</if>
            <if test="updateBy != null">UPDATE_BY = #{updateBy},</if>
            <if test="updaterId != null">UPDATER_ID = #{updaterId},</if>
            <if test="updateTime != null">UPDATE_TIME = #{updateTime},</if>
            <if test="remark != null">REMARK = #{remark},</if>
        </trim>
        where ID = #{id}
    </update>

    <delete id="deleteDgDesensitizeIntervalById" parameterType="Long">
        delete from DG_DESENSITIZE_INTERVAL where ID = #{id}
    </delete>

    <delete id="deleteDgDesensitizeIntervalByIds" parameterType="String">
        delete from DG_DESENSITIZE_INTERVAL where ID in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
