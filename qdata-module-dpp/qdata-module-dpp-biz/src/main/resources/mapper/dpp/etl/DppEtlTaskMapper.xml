    <select id="checkTaskIdInSubTasks" parameterType="Long" resultType="int">
        SELECT COUNT(1)
        FROM DPP_ETL_TASK dt
        WHERE dt.DEL_FLAG = '0'
          AND dt.TYPE = '4'
          AND dt.id IN (
            SELECT rel.TASK_ID
            FROM DPP_ETL_TASK_NODE_REL rel
                     JOIN DPP_ETL_NODE node
                          ON (node.CODE = rel.PRE_NODE_CODE OR node.CODE = rel.POST_NODE_CODE)
            WHERE
                <choose>
                    <when test="@tech.qiantong.qdata.mybatis.config.MasterDataSourceConfig@getDatabaseType() == 'mysql'">
                        CAST(
                            SUBSTRING_INDEX(
                                SUBSTRING_INDEX(
                                    node.PARAMETERS,
                                    '"subTaskId":',
                                    -1
                                ),
                                ',',
                                1
                            ) AS UNSIGNED
                        )
                    </when>
                    <when test="@tech.qiantong.qdata.mybatis.config.MasterDataSourceConfig@getDatabaseType() == 'dm8'">
                        TO_NUMBER(
                        REGEXP_SUBSTR(node.PARAMETERS,
                        '"subTaskId"[[:space:]]*:[[:space:]]*([0-9]+)',
                        1, 1, NULL, 1)
                        )
                    </when>
                </choose> = #{id}
        );
    </select>

    <select id="checkTaskIdInDatasource" parameterType="Long" resultType="int">
        SELECT COUNT(1)
        FROM DPP_ETL_TASK dt
        WHERE dt.DEL_FLAG = '0'
          AND dt.TYPE != '4'
            <if test="projectIdList != null and projectIdList.size > 0">
                AND dt.PROJECT_ID in
                <foreach item="id" collection="projectIdList" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </if>
          AND dt.id IN (
            SELECT rel.TASK_ID
            FROM DPP_ETL_TASK_NODE_REL rel
                     JOIN DPP_ETL_NODE node
                          ON (node.CODE = rel.PRE_NODE_CODE OR node.CODE = rel.POST_NODE_CODE)
            WHERE
                <choose>
                    <when test="@tech.qiantong.qdata.mybatis.config.MasterDataSourceConfig@getDatabaseType() == 'mysql'">
                        CAST(
                            JSON_UNQUOTE(JSON_EXTRACT(node.PARAMETERS, '$.datasourceId'))
                            AS UNSIGNED
                        )
                    </when>
                    <when test="@tech.qiantong.qdata.mybatis.config.MasterDataSourceConfig@getDatabaseType() == 'dm8'">
                                TO_NUMBER(
                                REGEXP_SUBSTR(node.PARAMETERS,
                                '"datasourceId"[[:space:]]*:[[:space:]]*([0-9]+)',
                                1, 1, NULL, 1)
                                )
                    </when>
                </choose>
                        in
                        <foreach item="id" collection="datasourceIdList" open="(" separator="," close=")">
                            #{id}
                        </foreach>
        );
    </select>
    <select id="checkTaskIdInAsset" parameterType="Long" resultType="int">
        SELECT COUNT(1)
        FROM DPP_ETL_TASK dt
        WHERE dt.DEL_FLAG = '0'
            AND dt.TYPE = '1'
            AND dt.id IN (
                SELECT rel.TASK_ID
                FROM DPP_ETL_TASK_NODE_REL rel
                    JOIN DPP_ETL_NODE node
                        ON (node.CODE = rel.PRE_NODE_CODE OR node.CODE = rel.POST_NODE_CODE)
                WHERE
                <choose>
                    <when test="@tech.qiantong.qdata.mybatis.config.MasterDataSourceConfig@getDatabaseType() == 'mysql'">
                        CAST(
                            SUBSTRING_INDEX(
                                SUBSTRING_INDEX(
                                    node.PARAMETERS,
                                    '"clmt":',
                                    -1
                                ),
                                ',',
                                1
                            ) AS UNSIGNED
                        ) = 1
                        AND
                            CAST(
                            SUBSTRING_INDEX(
                                SUBSTRING_INDEX(
                                    node.PARAMETERS,
                                    '"asset_id_cpoy":',
                                    -1
                                ),
                                ',',
                                1
                            ) AS UNSIGNED
                        )
                    </when>
                    <when test="@tech.qiantong.qdata.mybatis.config.MasterDataSourceConfig@getDatabaseType() == 'dm8'">
                        TO_NUMBER(
                        REGEXP_SUBSTR(node.PARAMETERS,
                        '"clmt"[[:space:]]*:[[:space:]]*"?([0-9]+)"?',
                        1, 1, NULL, 1)
                        )=1 AND
                        TO_NUMBER(
                        REGEXP_SUBSTR(node.PARAMETERS,
                        '"asset_id_cpoy"[[:space:]]*:[[:space:]]*([0-9]+)',
                        1, 1, NULL, 1)
                        )
                    </when>
                </choose>
                           in
                          <foreach item="id" collection="assetIdList" open="(" separator="," close=")">
                              #{id}
                          </foreach>

            );
    </select>

    <select id="getDppEtlTaskPage" resultType="tech.qiantong.qdata.module.dpp.controller.admin.etl.vo.DppEtlTaskRespVO">
        SELECT
            t.*,
            cu.NICK_NAME AS personChargeName,
            u.PHONENUMBER AS createUserContactNumber,
            t2.NAME AS catName,
            t3.CRON_EXPRESSION AS cronExpression,
            t3.STATUS AS schedulerState,
            ti.CREATE_TIME AS lastExecuteTime,
            ti.END_TIME AS lastExecuteEndTime,
            ti.STATUS AS lastExecuteStatus,
            ti.ID AS taskInstanceId
            <if test="params.type == '3'.toString()">
                <choose>
                    <when test="@tech.qiantong.qdata.mybatis.config.MasterDataSourceConfig@getDatabaseType() == 'dm8'">
                        ,JSON_VALUE(t.DRAFT_JSON, '$.typaCode') AS datasourceType
                    </when>
                    <when test="@tech.qiantong.qdata.mybatis.config.MasterDataSourceConfig@getDatabaseType() == 'mysql'">
                        ,JSON_EXTRACT(t.DRAFT_JSON, '$.typaCode') AS datasourceType
                    </when>

                    <otherwise>
                        ,TRIM(BOTH '"' FROM SUBSTR(t.DRAFT_JSON, INSTR(t.DRAFT_JSON, '"typaCode"') + 12, 50)) AS datasourceType
                    </otherwise>
                </choose>
                ,(SELECT t4.ID FROM DPP_ETL_TASK_INSTANCE t4 WHERE t4.TASK_CODE = t.CODE AND t4.DEL_FLAG = '0' AND t4.STATUS IN ('0','1') ORDER BY t4.CREATE_TIME DESC LIMIT 1) AS taskInstanceId
            </if>
        FROM
            DPP_ETL_TASK t
            LEFT JOIN SYSTEM_USER u on t.CREATOR_ID = u.USER_ID AND u.DEL_FLAG = '0'
            LEFT JOIN SYSTEM_USER cu on t.PERSON_CHARGE = cu.USER_ID AND cu.DEL_FLAG = '0'
        <choose>
            <when test="params.type == '1'.toString()">
                LEFT JOIN  ATT_TASK_CAT t2 ON t.CAT_CODE = t2.CODE AND t2.DEL_FLAG = '0'
            </when>
            <when test="params.type == '3'.toString()">
                LEFT JOIN ATT_DATA_DEV_CAT t2 ON t.CAT_CODE = t2.CODE AND t2.DEL_FLAG = '0'
            </when>
            <when test="params.type == '4'.toString()">
                LEFT JOIN ATT_JOB_CAT t2 ON t.CAT_CODE = t2.CODE AND t2.DEL_FLAG = '0'
            </when>
        </choose>
        LEFT JOIN DPP_ETL_SCHEDULER t3 ON t.id = t3.task_id AND t3.DEL_FLAG = '0'
        <!-- Key modification: subquery joining the latest instance of each task -->
        LEFT JOIN (
            SELECT
                ti1.ID, ti1.TASK_CODE, ti1.CREATE_TIME, ti1.END_TIME, ti1.STATUS
            FROM
                DPP_ETL_TASK_INSTANCE ti1
                JOIN (
                    SELECT
                        ti2.TASK_CODE, MAX(ti2.ID) AS ID
                    FROM
                        DPP_ETL_TASK_INSTANCE ti2
                    WHERE
                        ti2.DEL_FLAG = '0'
                    GROUP BY ti2.TASK_CODE
                ) maxData ON maxData.TASK_CODE = ti1.TASK_CODE AND maxData.ID = ti1.ID
            WHERE
                ti1.DEL_FLAG = '0'
        ) ti ON ti.TASK_CODE = t.CODE
        WHERE
            t.DEL_FLAG = '0'
            AND t.STATUS NOT IN ('-2', '-3')
            AND t.TYPE = #{params.type}
            <if test="params.catCode != null and params.catCode != ''">
                AND t.CAT_CODE LIKE CONCAT(#{params.catCode}, '%')
            </if>
            <if test="params.name != null and params.name != ''">
                AND t.NAME LIKE CONCAT('%',CONCAT(#{params.name},'%'))
            </if>
            <if test="params.code != null and params.code != ''">
                AND t.CODE = #{params.code}
            </if>
            <if test="params.projectId != null">
                AND t.PROJECT_ID = #{params.projectId}
            </if>
            <if test="params.projectCode != null and params.projectCode != ''">
                AND t.PROJECT_CODE = #{params.projectCode}
            </if>
            <if test="params.personCharge != null and params.personCharge != ''">
                AND t.PERSON_CHARGE = #{params.personCharge}
            </if>
            <if test="params.status != null and params.status != ''">
                AND t.STATUS = #{params.status}
            </if>
            <if test="params.currentStatus != null and params.currentStatus != '' and params.currentStatus == 'idle'.toString()">
                AND (ti.STATUS IS NULL OR ti.STATUS NOT IN ('0', '1', '12', '7', '6'))
            </if>
            <if test="(params.currentStatus != null and params.currentStatus != '' and params.currentStatus != 'idle'.toString()) or params.startTime != null or params.endTime != null">
                    <if test="params.currentStatus != null and params.currentStatus != '' and params.currentStatus != 'idle'.toString()">
                        <choose>
                            <when test="params.currentStatus == 'running'.toString()">
                                AND ti.STATUS IN ('0', '1', '12')
                            </when>
                            <when test="params.currentStatus == 'success'.toString()">
                                AND ti.STATUS = '7'
                            </when>
                            <when test="params.currentStatus == 'failed'.toString()">
                                AND ti.STATUS = '6'
                            </when>
                        </choose>
                    </if>
                    <if test="params.startTime != null">
                        AND ti.CREATE_TIME &gt;= #{params.startTime}
                    </if>
                    <if test="params.endTime != null">
                        AND ti.END_TIME &lt;= #{params.endTime}
                    </if>
            </if>
            <if test="params.type == '3'.toString() and params.processType != null and params.processType != ''">
                <choose>
                    <when test="params.processType == '1'.toString()">
                        <choose>
                            <when test="@tech.qiantong.qdata.mybatis.config.MasterDataSourceConfig@getDatabaseType() == 'dm8'">
                                AND JSON_VALUE(t.DRAFT_JSON, '$.typaCode') = 'FlinkStream'
                            </when>
                            <when test="@tech.qiantong.qdata.mybatis.config.MasterDataSourceConfig@getDatabaseType() == 'mysql'">
                                AND JSON_EXTRACT(t.DRAFT_JSON, '$.typaCode') = 'FlinkStream'
                            </when>
                        </choose>
                    </when>
                    <when test="params.processType == '2'.toString()">
                        <choose>
                            <when test="@tech.qiantong.qdata.mybatis.config.MasterDataSourceConfig@getDatabaseType() == 'dm8'">
                                AND JSON_VALUE(t.DRAFT_JSON, '$.typaCode') != 'FlinkStream'
                            </when>
                            <when test="@tech.qiantong.qdata.mybatis.config.MasterDataSourceConfig@getDatabaseType() == 'mysql'">
                                AND JSON_EXTRACT(t.DRAFT_JSON, '$.typaCode') != 'FlinkStream'
                            </when>
                        </choose>
                    </when>
                </choose>
            </if>
            <if test="params.type == '3'.toString() and params.datasourceType != null and params.datasourceType != ''">
                <choose>
                    <when test="@tech.qiantong.qdata.mybatis.config.MasterDataSourceConfig@getDatabaseType() == 'dm8'">
                        AND JSON_VALUE(t.DRAFT_JSON, '$.typaCode') = #{params.datasourceType}
                    </when>
                    <when test="@tech.qiantong.qdata.mybatis.config.MasterDataSourceConfig@getDatabaseType() == 'mysql'">
                        AND JSON_EXTRACT(t.DRAFT_JSON, '$.typaCode') = #{params.datasourceType}
                    </when>
                </choose>
            </if>
        <if test="params.orderByColumn != null and params.orderByColumn != ''">
            ORDER BY ${params.orderByColumn}
            <if test="params.isAsc != null and params.isAsc != ''">
                ${params.isAsc}
            </if>
        </if>
    </select>

    <select id="getDppEtlTaskStatistics" resultMap="DppEtlTaskStatisticsResult">
        SELECT
            COUNT(DISTINCT CASE WHEN ti.STATUS IN ('0', '1', '12') THEN t.ID END) AS RUNNING_COUNT,
            COUNT(DISTINCT CASE WHEN latestTi.STATUS = '6'  THEN t.ID END) AS RECENT_FAILED_COUNT,
            COALESCE(SUM(CASE WHEN ti.CREATE_TIME &gt;= #{beginOfDay} AND ti.CREATE_TIME &lt;= #{endOfDay} THEN 1 ELSE 0 END), 0) AS TODAY_EXECUTE_COUNT,
            CASE
                WHEN COALESCE(SUM(CASE WHEN ti.STATUS IN ('6', '7') AND ti.CREATE_TIME &gt;= #{beginOfDay} AND ti.CREATE_TIME &lt;= #{endOfDay} THEN 1 ELSE 0 END), 0) = 0 THEN 0
                ELSE SUM(CASE WHEN ti.STATUS = '7' AND ti.CREATE_TIME &gt;= #{beginOfDay} AND ti.CREATE_TIME &lt;= #{endOfDay} THEN 1 ELSE 0 END) * 100.0
                    / SUM(CASE WHEN ti.STATUS IN ('6', '7') AND ti.CREATE_TIME &gt;= #{beginOfDay} AND ti.CREATE_TIME &lt;= #{endOfDay} THEN 1 ELSE 0 END)
            END AS TODAY_SUCCESS_RATE
        FROM DPP_ETL_TASK t
        LEFT JOIN DPP_ETL_TASK_INSTANCE ti
            ON ti.TASK_ID = t.ID
            AND ti.TASK_TYPE = #{taskType}
            AND ti.DEL_FLAG = '0'
        LEFT JOIN (
            SELECT ti1.TASK_ID, ti1.STATUS
            FROM DPP_ETL_TASK_INSTANCE ti1
            JOIN (
                SELECT TASK_ID, MAX(ID) AS ID
                FROM DPP_ETL_TASK_INSTANCE
                WHERE DEL_FLAG = '0' AND TASK_TYPE = #{taskType}
                GROUP BY TASK_ID
            ) maxData ON maxData.ID = ti1.ID
            WHERE ti1.DEL_FLAG = '0' AND ti1.TASK_TYPE = #{taskType} AND ti1.CREATE_TIME &gt;= #{beginOfDay} AND ti1.CREATE_TIME &lt;= #{endOfDay}
        ) latestTi ON latestTi.TASK_ID = t.ID
        WHERE t.DEL_FLAG = '0'
            AND t.STATUS NOT IN ('-2', '-3')
            AND t.TYPE = #{taskType}
            AND t.PROJECT_ID = #{projectId}
            AND t.PROJECT_CODE = #{projectCode}
    </select>
</mapper>
