<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tech.qiantong.qdata.module.dg.dal.mapper.desensitizeRules.DgDesensitizeRuleMapper">

    <resultMap type="DgDesensitizeRuleDO" id="DgDesensitizeRuleResult">
        <result property="id"    column="ID"    />
        <result property="name"    column="NAME"    />
        <result property="dataCategoryId"    column="DATA_CATEGORY_ID"    />
        <result property="applicationScene"    column="APPLICATION_SCENE"    />
        <result property="maskType"    column="MASK_TYPE"    />
        <result property="replaceRule"    column="REPLACE_RULE"    />
        <result property="replaceContent"    column="REPLACE_CONTENT"    />
        <result property="sortOrder"    column="SORT_ORDER"    />
        <result property="description"    column="DESCRIPTION"    />
        <result property="validFlag"    column="VALID_FLAG"    />
        <result property="delFlag"    column="DEL_FLAG"    />
        <result property="createBy"    column="CREATE_BY"    />
        <result property="creatorId"    column="CREATOR_ID"    />
        <result property="createTime"    column="CREATE_TIME"    />
        <result property="updateBy"    column="UPDATE_BY"    />
        <result property="updaterId"    column="UPDATER_ID"    />
        <result property="updateTime"    column="UPDATE_TIME"    />
        <result property="remark"    column="REMARK"    />
    </resultMap>

    <sql id="selectDgDesensitizeRuleVo">
        select ID, NAME, DATA_CATEGORY_ID, APPLICATION_SCENE, MASK_TYPE, REPLACE_RULE, REPLACE_CONTENT, SORT_ORDER, DESCRIPTION, VALID_FLAG, DEL_FLAG, CREATE_BY, CREATOR_ID, CREATE_TIME, UPDATE_BY, UPDATER_ID, UPDATE_TIME, REMARK from DG_DESENSITIZE_RULE
    </sql>

    <select id="selectDgDesensitizeRuleList" parameterType="DgDesensitizeRuleDO" resultMap="DgDesensitizeRuleResult">
        <include refid="selectDgDesensitizeRuleVo"/>
        <where>
            <if test="name != null  and name != ''"> and NAME like concat(concat('%', #{name}), '%')</if>
            <if test="dataCategoryId != null "> and DATA_CATEGORY_ID = #{dataCategoryId}</if>
            <if test="applicationScene != null  and applicationScene != ''"> and APPLICATION_SCENE = #{applicationScene}</if>
            <if test="maskType != null  and maskType != ''"> and MASK_TYPE = #{maskType}</if>
            <if test="replaceRule != null  and replaceRule != ''"> and REPLACE_RULE = #{replaceRule}</if>
            <if test="replaceContent != null  and replaceContent != ''"> and REPLACE_CONTENT = #{replaceContent}</if>
            <if test="sortOrder != null "> and SORT_ORDER = #{sortOrder}</if>
            <if test="description != null  and description != ''"> and DESCRIPTION = #{description}</if>
            <if test="validFlag != null "> and VALID_FLAG = #{validFlag}</if>
            <if test="createTime != null "> and CREATE_TIME = #{createTime}</if>
        </where>
    </select>

    <select id="selectDgDesensitizeRuleById" parameterType="Long" resultMap="DgDesensitizeRuleResult">
        <include refid="selectDgDesensitizeRuleVo"/>
        where ID = #{id}
    </select>

    <insert id="insertDgDesensitizeRule" parameterType="DgDesensitizeRuleDO">
        insert into DG_DESENSITIZE_RULE
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">ID,</if>
            <if test="name != null">NAME,</if>
            <if test="dataCategoryId != null">DATA_CATEGORY_ID,</if>
            <if test="applicationScene != null">APPLICATION_SCENE,</if>
            <if test="maskType != null">MASK_TYPE,</if>
            <if test="replaceRule != null">REPLACE_RULE,</if>
            <if test="replaceContent != null">REPLACE_CONTENT,</if>
            <if test="sortOrder != null">SORT_ORDER,</if>
            <if test="description != null">DESCRIPTION,</if>
            <if test="validFlag != null">VALID_FLAG,</if>
            <if test="delFlag != null">DEL_FLAG,</if>
            <if test="createBy != null">CREATE_BY,</if>
            <if test="creatorId != null">CREATOR_ID,</if>
            <if test="createTime != null">CREATE_TIME,</if>
            <if test="updateBy != null">UPDATE_BY,</if>
            <if test="updaterId != null">UPDATER_ID,</if>
            <if test="updateTime != null">UPDATE_TIME,</if>
            <if test="remark != null">REMARK,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="name != null">#{name},</if>
            <if test="dataCategoryId != null">#{dataCategoryId},</if>
            <if test="applicationScene != null">#{applicationScene},</if>
            <if test="maskType != null">#{maskType},</if>
            <if test="replaceRule != null">#{replaceRule},</if>
            <if test="replaceContent != null">#{replaceContent},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="description != null">#{description},</if>
            <if test="validFlag != null">#{validFlag},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="creatorId != null">#{creatorId},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updaterId != null">#{updaterId},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateDgDesensitizeRule" parameterType="DgDesensitizeRuleDO">
        update DG_DESENSITIZE_RULE
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null">NAME = #{name},</if>
            <if test="dataCategoryId != null">DATA_CATEGORY_ID = #{dataCategoryId},</if>
            <if test="applicationScene != null">APPLICATION_SCENE = #{applicationScene},</if>
            <if test="maskType != null">MASK_TYPE = #{maskType},</if>
            <if test="replaceRule != null">REPLACE_RULE = #{replaceRule},</if>
            <if test="replaceContent != null">REPLACE_CONTENT = #{replaceContent},</if>
            <if test="sortOrder != null">SORT_ORDER = #{sortOrder},</if>
            <if test="description != null">DESCRIPTION = #{description},</if>
            <if test="validFlag != null">VALID_FLAG = #{validFlag},</if>
            <if test="delFlag != null">DEL_FLAG = #{delFlag},</if>
            <if test="createBy != null">CREATE_BY = #{createBy},</if>
            <if test="creatorId != null">CREATOR_ID = #{creatorId},</if>
            <if test="createTime != null">CREATE_TIME = #{createTime},</if>
            <if test="updateBy != null">UPDATE_BY = #{updateBy},</if>
            <if test="updaterId != null">UPDATER_ID = #{updaterId},</if>
            <if test="updateTime != null">UPDATE_TIME = #{updateTime},</if>
            <if test="remark != null">REMARK = #{remark},</if>
        </trim>
        where ID = #{id}
    </update>

    <delete id="deleteDgDesensitizeRuleById" parameterType="Long">
        delete from DG_DESENSITIZE_RULE where ID = #{id}
    </delete>

    <delete id="deleteDgDesensitizeRuleByIds" parameterType="String">
        delete from DG_DESENSITIZE_RULE where ID in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
